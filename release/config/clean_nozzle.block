# >>> M_Bamboo_SV08MAX_MOD:CONFIG_CLEAN_NOZZLE BEGIN >>>
# Version: NC-R1
# Maintainer: Master_Bamboo / 竹子
# Purpose: One contact datum; all wipe stages stay at contact +0.30 mm.
[gcode_macro CLEAN_NOZZLE]
gcode:
    BED_MESH_CLEAR
    {% if printer.toolhead.homed_axes != "xyz" or printer.gcode_move.position.z < 5 %}
       G28
    {% endif %}
    M109 S200
    G90
    {% set contact_x_offset = range(-1, 2) | random %}
    {% set contact_y_offset = range(-10, 11) | random %}
    {% set wipe_y_offset = range(-3, 4) | random %}
    { action_respond_info("CLEAN_NOZZLE NC-R1: contact X=%.1f Y=%.1f, wipe Y offset=%+d; wipe plane=contact+0.30mm" % (30 + contact_x_offset, 195 + contact_y_offset, wipe_y_offset)) }
    G1 X{30 + contact_x_offset} Y{195 + contact_y_offset} F9000
    RUN_PROBE_VIR_CONTACT
    G91
    G1 Z3.0
    G90
    G1 X-7 F2400
    G91
    G1 Z-2.7
    G90
    G1 X-9 Y{205 + wipe_y_offset} F2400
    G1 X-7 Y{205 + wipe_y_offset}
    G1 X-9 Y{205 + wipe_y_offset}
    G1 X-7 Y{205 + wipe_y_offset}
    G1 X-9 Y{213 + wipe_y_offset}
    G1 X-7 Y{213 + wipe_y_offset}
    G1 X-9 Y{213 + wipe_y_offset}
    G1 X-7 Y{213 + wipe_y_offset}
    G1 X-9 Y{221 + wipe_y_offset}
    G1 X-7 Y{221 + wipe_y_offset}
    G1 X-9 Y{221 + wipe_y_offset}
    G1 X-7 Y{221 + wipe_y_offset}
    G1 X-9 Y{205 + wipe_y_offset}
    G1 X-7 Y{213 + wipe_y_offset}
    G1 X-9 Y{221 + wipe_y_offset}
    G1 X-7 Y{213 + wipe_y_offset}
    G1 X-9 Y{205 + wipe_y_offset}
    G1 X-7 Y{221 + wipe_y_offset}
    G91
    G1 Z5.0
    G90
    G1 Y260 F9000
    G91
    G1 Z-5.0
    G90
    G1 Y283 F2400
    G1 Y260
    G1 Y283
    G1 Y260
    G1 Y283
    M106 S255
    M109 S130
    M106 S0
    G1 Z10
# <<< M_Bamboo_SV08MAX_MOD:CONFIG_CLEAN_NOZZLE END <<<
