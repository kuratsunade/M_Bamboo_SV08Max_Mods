+    def _decode_transport_type(self, evidence):
+        bits = evidence.get('known_bits') or ()
+        text = '|'.join(bits) if bits else 'UNKNOWN_I2C_FAULT'
+        unknown = evidence.get('unknown_bits', 0)
+        if unknown:
+            text += '|UNKNOWN_BITS_0x%x' % (unknown,)
+        return text
