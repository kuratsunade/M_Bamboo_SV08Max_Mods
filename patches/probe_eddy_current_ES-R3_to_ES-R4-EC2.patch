+    def preflight_transport_ready(self, context='EDDY_MOTION'):
+        # Do not silently bypass an already-latched failure.  Armed Safe Home
+        # recovery has its own explicit authorization path and has already
+        # passed M_BAMBOO_EDDY_RECOVERY_CHECK.
+        self._consume_pending_transport_fault()
+        if self._fault_state is not None:
+            self._check_fault()
+        if self._active_transaction is not None:
+            raise self._printer.command_error(
+                'M_Bamboo Eddy Safety: transport preflight requested while an '
+                'Eddy transaction is active')
+        checker = getattr(self._sensor_helper, 'check_transport_health', None)
+        if checker is None:
+            return True
+        self._preflight_check_count += 1
+        entry_seq = self._transport_seq()
+        attempts = (
+            (0.025, 2, 0.025),
+            (0.075, 2, 0.025),
+            (0.125, 2, 0.025),
+        )
+        self._preflight_active = True
+        self._preflight_context = context
+        self._preflight_fault_seen = False
+        self._preflight_last_fault = {}
+        results = []
+        clean_after_failure = 0
+        try:
+            for attempt_no, (settle, reads, gap) in enumerate(attempts, 1):
+                result = checker(
+                    settle_time=settle, read_count=reads, read_gap=gap)
+                results.append(dict(result))
+                # Consume a serial-thread sequence that may have arrived before
+                # its reactor callback.  While preflight_active this records
+                # evidence but deliberately does not latch a motion fault.
+                self._consume_pending_transport_fault()
+                current_seq = self._transport_seq()
+                clean = bool(result.get('ok') and
+                             result.get('seq_end') == current_seq)
+                if clean:
+                    if self._preflight_fault_seen or len(results) > 1:
+                        clean_after_failure += 1
+                        if clean_after_failure < 2:
+                            self._diag(1, 'PREARM context=%s attempt=%d clean; '
+                                       'requiring one more clean window after '
+                                       'transient/failed readiness check'
+                                       % (context, attempt_no))
+                            continue
+                    if current_seq > entry_seq:
+                        marker = getattr(
+                            self._sensor_helper,
+                            'mark_transport_recovered_through', None)
+                        if marker is not None:
+                            marker(current_seq)
+                        self._preflight_transient_recovered_count += 1
+                        self._diag(0, 'PREARM RECOVERED context=%s fault_seq=%d->%d; '
+                                   'transport stable before motion, Z trust '
+                                   'unchanged' % (context, entry_seq, current_seq))
+                    else:
+                        self._diag(2, 'PREARM READY context=%s attempt=%d seq=%d'
+                                   % (context, attempt_no, current_seq))
+                    self._transport_state = 'HEALTHY'
+                    return True
+                clean_after_failure = 0
+                self._diag(1, 'PREARM NOT READY context=%s attempt=%d/%d '
+                           'seq=%s->%s reads=%d; motion remains held'
+                           % (context, attempt_no, len(attempts),
+                              result.get('seq_start'), result.get('seq_end'),
+                              len(result.get('reads', ()))))
+        finally:
+            self._preflight_active = False
+            self._preflight_context = None
+        self._preflight_failed_count += 1
+        self._z_recovery_required = False
+        self._transport_state = 'TRANSPORT_FAULT'
+        self._recovery_authorized = False
+        self._safe_home_recovery_token = False
+        last = results[-1] if results else {}
+        evidence = self._preflight_last_fault
+        if evidence:
+            reason = 'PREARM_NOT_READY|' + self._decode_transport_reason(evidence)
+        else:
+            reason = ('PREARM_NOT_READY identity/readiness check failed '
+                      'seq=%s->%s' %
+                      (last.get('seq_start'), last.get('seq_end')))
+        self._set_fault('HARD_COMM_FAULT', reason)
+        raise self._printer.command_error(
+            'M_Bamboo Eddy Safety: transport was not stable before %s; no '
+            'bed-facing Z motion was started. %s'
+            % (context, self._recovery_guidance()))
+
+    def run_transport_recovery_check(self, gcmd):
+        self._consume_pending_transport_fault()
+        self._recovery_check_count += 1
+        if self._fault_state is None:
+            self._transport_state = 'HEALTHY'
+            self._recovery_authorized = False
+            gcmd.respond_info(
+                'MBEDDY RECOVERY: transport is already HEALTHY; no recovery '
+                'check is required.')
+            return
+        if self._restart_required or self._transport_state == 'HARD_COMM_FAULT':
+            raise gcmd.error(
+                'M_Bamboo Eddy Recovery: a previous armed recovery failed; '
+                'FIRMWARE_RESTART is required before another Z recovery')
+        if self._active_transaction is not None:
+            raise gcmd.error(
+                'M_Bamboo Eddy Recovery: cannot run a transport health check '
+                'while an Eddy transaction is active')
+        checker = getattr(self._sensor_helper, 'check_transport_health', None)
+        if checker is None:
+            raise gcmd.error(
+                'M_Bamboo Eddy Recovery: sensor backend does not provide a '
+                'transport health check')
+        before = self._transport_seq()
+        gcmd.respond_info(
+            'MBEDDY RECOVERY: no-motion transport check starting; current '
+            'action remains aborted and Z remains untrusted.')
+        result = checker()
+        self._last_recovery_check = dict(result)
+        after = self._transport_seq()
+        if result.get('ok') and after == before:
+            self._recovery_check_pass_count += 1
+            reads = result.get('reads', ())
+            read_text = ', '.join('%04x/%04x' % pair for pair in reads)
+            if not self._z_recovery_required:
+                self._transport_state = 'HEALTHY'
+                self._recovery_authorized = False
+                self._recovery_attempt_used = False
+                self._fault_state = None
+                self._fault_reason = None
+                marker = getattr(
+                    self._sensor_helper, 'mark_transport_recovered_through', None)
+                if marker is not None:
+                    marker(after)
+                gcmd.respond_info(
+                    'MBEDDY RECOVERY: RECOVERED. LDC identity reads=[%s], '
+                    'fault_seq=%d unchanged. The fault was caught before '
+                    'bed-facing Z motion, so existing Z trust is unchanged '
+                    'and normal operations may resume.' % (read_text, after))
+                return
+            self._transport_state = 'TRANSPORT_RECOVERED'
+            self._recovery_authorized = True
+            self._recovery_attempt_used = False
+            gcmd.respond_info(
+                'MBEDDY RECOVERY: RECOVERED. LDC identity reads=[%s], '
+                'fault_seq=%d unchanged. Z is still UNTRUSTED. Run one G28 '
+                'to perform the armed Safe Home recovery.' % (read_text, after))
+            return
+        self._transport_state = 'TRANSPORT_FAULT'
+        self._recovery_authorized = False
+        reads = result.get('reads', ())
+        read_text = ', '.join('%04x/%04x' % pair for pair in reads) or '<none>'
+        gcmd.respond_info(
+            'MBEDDY RECOVERY: NOT RECOVERED. reads=[%s] fault_seq=%s->%s '
+            'error=%s. No Z motion was attempted. You may wait and run '
+            'M_BAMBOO_EDDY_RECOVERY_CHECK again, or use FIRMWARE_RESTART. '
+            'If the fault repeats, inspect the Eddy cable/connector and '
+            'extra_mcu I2C path.' % (
+                read_text, result.get('seq_start'), result.get('seq_end'),
+                result.get('error') or 'None'))
+
+    def arm_safe_home_recovery(self):
+        # Called only by M_Bamboo Safe Home immediately before its raw Z home.
+        # It never restores Z trust by itself.
+        self._consume_pending_transport_fault()
+        if self._fault_state is None:
+            self._safe_home_recovery_token = False
+            return False
+        if (self._restart_required or self._recovery_attempt_used
+                or self._transport_state == 'HARD_COMM_FAULT'):
+            raise self._printer.command_error(
+                'M_Bamboo Eddy Recovery: recovery attempt is no longer '
+                'authorized; FIRMWARE_RESTART is required')
+        if (self._transport_state != 'TRANSPORT_RECOVERED'
+                or not self._recovery_authorized):
+            raise self._printer.command_error(
+                'M_Bamboo Eddy Recovery: transport has not been confirmed '
+                'recovered. Run M_BAMBOO_EDDY_RECOVERY_CHECK first')
+        self._safe_home_recovery_token = True
+        return True
+
+    def _complete_recovery_success(self, tx):
