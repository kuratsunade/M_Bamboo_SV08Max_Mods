+        fault_type = self._decode_transport_type(evidence)
+        context = self._transport_fault_context()
+        self._transport_fault_count += 1
+        self._transport_fault_type_counts[fault_type] = (
+            self._transport_fault_type_counts.get(fault_type, 0) + 1)
+        self._transport_fault_context_counts[context] = (
+            self._transport_fault_context_counts.get(context, 0) + 1)
+        record = dict(evidence)
+        record['type'] = fault_type
+        record['context'] = context
+        record['recorded_time'] = self._printer.get_reactor().monotonic()
+        self._last_transport_fault = record
