# >>> M_Bamboo_SV08MAX_MOD:CONFIG_CLEAN_NOZZLE BEGIN >>>
# Version: 1
# Maintainer: Master_Bamboo / 竹子
# Purpose: Randomized contact point and cross-hatch wiping pattern.
# 用途：随机接触点与交叉擦拭，分散清洁区域磨损。
[gcode_macro CLEAN_NOZZLE]
gcode:
    BED_MESH_CLEAR
    
    {% if printer.toolhead.homed_axes != "xyz" or printer.gcode_move.position.z < 5 %}
       G28
    {% endif %}
    
    M109 S200
    G90
    
    # ------------------------------------------------------------
    # Randomized contact point
    #
    # The contact pad is approximately 6 x 28 mm and X30 Y195 is
    # assumed to be near its center.
    #
    # Randomizing this contact point spreads repeated nozzle loading
    # over a larger area instead of wearing a single dimple.
    #
    # X: +/-1 mm
    # Y: +/-10 mm
    # ------------------------------------------------------------
    {% set contact_x_offset = range(-1, 2) | random %}
    {% set contact_y_offset = range(-10, 11) | random %}
    
    # ------------------------------------------------------------
    # Randomized horizontal wipe-row offset
    #
    # The whole horizontal wiping pattern is shifted together by
    # up to +/-3 mm. This preserves the shape of the wipe while
    # distributing wear across nearby rows.
    #
    # Nominal rows:
    #   Y205
    #   Y213
    #   Y221
    #
    # Effective range after randomization:
    #   Y202..208
    #   Y210..216
    #   Y218..224
    #
    # These remain inside the Y190..236 range already used by the
    # original Sovol wiping macro.
    # ------------------------------------------------------------
    {% set wipe_y_offset = range(-3, 4) | random %}
    
    { action_respond_info(
        "CLEAN_NOZZLE: contact X=%.1f Y=%.1f, wipe Y offset=%+d"
        % (
            30 + contact_x_offset,
            195 + contact_y_offset,
            wipe_y_offset
        )
    ) }
    
    # ------------------------------------------------------------
    # Establish physical nozzle contact on the randomized location.
    # ------------------------------------------------------------
    G1 X{30 + contact_x_offset} Y{195 + contact_y_offset} F9000
    RUN_PROBE_VIR_CONTACT
    
    # Raise from the detected contact point before moving toward
    # the wiping area.
    G91
    G1 Z3
    G90
    
    G1 X-7 F2400
    
    # Lower to the original Sovol wiping depth.
    G91
    G1 Z-2.7
    G90
    
    # ------------------------------------------------------------
    # Cross-hatch wiping pattern
    #
    # Part 1: left/right scrubbing.
    #
    # Three horizontal rows are used. The rows are shifted together
    # using wipe_y_offset so each cleaning cycle does not scrub the
    # exact same lines.
    # ------------------------------------------------------------
    
    # Lower horizontal row.
    G1 X-9 Y{205 + wipe_y_offset} F2400
    G1 X-7 Y{205 + wipe_y_offset}
    G1 X-9 Y{205 + wipe_y_offset}
    G1 X-7 Y{205 + wipe_y_offset}
    
    # Middle horizontal row.
    G1 X-9 Y{213 + wipe_y_offset}
    G1 X-7 Y{213 + wipe_y_offset}
    G1 X-9 Y{213 + wipe_y_offset}
    G1 X-7 Y{213 + wipe_y_offset}
    
    # Upper horizontal row.
    G1 X-9 Y{221 + wipe_y_offset}
    G1 X-7 Y{221 + wipe_y_offset}
    G1 X-9 Y{221 + wipe_y_offset}
    G1 X-7 Y{221 + wipe_y_offset}
    
    # ------------------------------------------------------------
    # Part 2: top/bottom scrubbing.
    #
    # Keep the long vertical wipe fixed at X=-8 and within the
    # original Sovol Y190..236 travel range.
    #
    # These endpoints are intentionally NOT randomized until the
    # exact physical boundaries of this wiping surface are known.
    # ------------------------------------------------------------
    G1 X-8 Y190
    G1 X-8 Y236
    G1 X-8 Y190
    G1 X-8 Y236
    
    # ------------------------------------------------------------
    # Leave the cleaning surface.
    # ------------------------------------------------------------
    G91
    G1 Z5
    G90
    
    # ------------------------------------------------------------
    # Original secondary wiping / cooling section.
    #
    # This section is left unchanged.
    # ------------------------------------------------------------
    G1 Y260 F9000
    
    G91
    G1 Z-6.0
    G90
    
    G1 Y283 F2400
    G1 Y260
    G1 Y283
    
    M106 S255
    M109 S130
    M106 S0
    
    # Finish at a predictable Z so the following
    # Z_OFFSET_CALIBRATION USE_CURRENT_Z=1 can preserve this
    # established Z reference.
    G1 Z10
# <<< M_Bamboo_SV08MAX_MOD:CONFIG_CLEAN_NOZZLE END <<<
